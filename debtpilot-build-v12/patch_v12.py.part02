.VISIBILITY_PUBLIC).setContentIntent(openApp)
            .setAutoCancel(offsetDays > 0).setOngoing(fullScreen && offsetDays == 0)
        if (fullScreen && offsetDays == 0) builder.setFullScreenIntent(fullScreenPending, true)

        try { NotificationManagerCompat.from(context).notify(if (isTest) TEST_NOTIFICATION_ID else requestNotificationId(id, offsetDays), builder.build()) } catch (_: SecurityException) {}

        if (!isTest && offsetDays == 0 && id > 0 && due.isNotBlank()) {
            val pending = goAsync()
            thread(name = "DebtPilotAlarmRollForward") {
                try {
                    val db = DebtDatabase(context.applicationContext)
                    val current = db.getLoan(id)
                    if (current != null && current.status == LoanStatus.ACTIVE && current.repeatMode != RepeatMode.NONE) {
                        val firedDue = runCatching { JalaliDate.parse(due) }.getOrNull()
                        if (firedDue != null) {
                            val nextDue = if (current.nextDueDate > firedDue) current.nextDueDate else ReminderPlanner.nextFutureDue(firedDue, current.repeatMode, JalaliDate.today())
                            ReminderScheduler(context.applicationContext).scheduleOccurrence(current, nextDue)
                        }
                    }
                    db.close()
                } finally { pending.finish() }
            }
        }
    }

    private fun createChannel(context: Context, loanId: Long, soundUri: String, vibrate: Boolean): String {
        val normalized = soundUri.ifBlank { ReminderScheduler.defaultAlarmUri().toString() }
        val channelId = "loan_alarm_${loanId}_${abs(normalized.hashCode())}_${if (vibrate) 1 else 0}"
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val manager = context.getSystemService(NotificationManager::class.java)
            if (manager.getNotificationChannel(channelId) == null) {
                val attrs = AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_ALARM).setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build()
                val channel = NotificationChannel(channelId, "Debt alarm ${if (loanId > 0) loanId else "test"}", NotificationManager.IMPORTANCE_HIGH).apply {
                    description = "Payment alarm for a DebtPilot loan"
                    setSound(Uri.parse(normalized), attrs); enableVibration(vibrate)
                    if (vibrate) vibrationPattern = longArrayOf(0, 450, 200, 450, 200, 700)
                    setShowBadge(true); lockscreenVisibility = android.app.Notification.VISIBILITY_PUBLIC
                }
                manager.createNotificationChannel(channel)
            }
        }
        return channelId
    }

    private fun requestNotificationId(loanId: Long, offset: Int): Int = (((loanId % 200_000_000L) * 10L + offset.coerceIn(0, 9)) % Int.MAX_VALUE).toInt()
    private fun formatMoney(v: Double): String = "%,.0f".format(v)
    companion object { private const val TEST_NOTIFICATION_ID = 2_146_000_001 }
}
''')

