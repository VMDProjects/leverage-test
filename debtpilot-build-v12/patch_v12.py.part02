import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.lifecycle.lifecycleScope
import com.debtpilot.offline.data.DebtDatabase
import com.debtpilot.offline.reminder.ReminderScheduler
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

class AlarmActivity : ComponentActivity() {
    private var player: MediaPlayer? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) { setShowWhenLocked(true); setTurnScreenOn(true) }
        else window.addFlags(WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED or WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON)
        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
        render()
    }

    override fun onNewIntent(intent: Intent) { super.onNewIntent(intent); setIntent(intent); stopSound(); render() }
    override fun onStart() { super.onStart(); startSound() }
    override fun onStop() { stopSound(); super.onStop() }

    private fun render() {
        val loanId=intent.getLongExtra("loanId",0L); val code=intent.getStringExtra("code").orEmpty(); val name=intent.getStringExtra("name") ?: "Payment reminder"
        val due=intent.getStringExtra("due").orEmpty(); val balance=intent.getDoubleExtra("balance",0.0); val sound=intent.getStringExtra("soundUri").orEmpty()
        val vibrate=intent.getBooleanExtra("vibrate",true); val scheduled=intent.getDoubleExtra("scheduledAmount",0.0); val isTest=intent.getBooleanExtra("isTest",false)
        setContent {
            MaterialTheme(colorScheme = darkColorScheme()) {
                Surface(Modifier.fillMaxSize()) {
                    Column(Modifier.fillMaxSize().padding(28.dp), verticalArrangement = Arrangement.SpaceBetween) {
                        Column(verticalArrangement = Arrangement.spacedBy(18.dp)) {
                            Text(if (isTest) "Alarm test" else "Payment due", style = MaterialTheme.typography.labelLarge, color = MaterialTheme.colorScheme.primary)
                            Text(name, style = MaterialTheme.typography.displaySmall, fontWeight = FontWeight.Bold)
                            if (code.isNotBlank()) Text(code, style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
                            HorizontalDivider()
                            Text("${"%,.0f".format(balance)} تومان", style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold)
                            Text("Due: $due شمسی", style = MaterialTheme.typography.titleLarge)
                            if (scheduled > 0) Text("Scheduled payment: ${"%,.0f".format(scheduled)} تومان")
                            Text("DebtPilot is reminding you at the exact time you selected.", color = MaterialTheme.colorScheme.onSurfaceVariant)
                        }
                        Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
                            Button(onClick = { ReminderScheduler(applicationContext).snooze(loanId,code,name,balance,due,sound,vibrate,10); finishAlarm(loanId) }, modifier = Modifier.fillMaxWidth().height(54.dp)) { Text("Snooze 10 minutes") }
                            if (!isTest && scheduled > 0 && loanId > 0) OutlinedButton(onClick = { markPaid(loanId) }, modifier = Modifier.fillMaxWidth().height(52.dp)) { Text("Mark scheduled payment paid") }
                            OutlinedButton(onClick = { startActivity(Intent(this@AlarmActivity, MainActivity::class.java)); finishAlarm(loanId) }, modifier = Modifier.fillMaxWidth()) { Text("Open DebtPilot") }
                            TextButton(onClick = { finishAlarm(loanId) }, modifier = Modifier.align(Alignment.CenterHorizontally)) { Text("Dismiss") }
                        }
                    }
                }
            }
        }
    }

    private fun markPaid(loanId: Long) {
        lifecycleScope.launch {
            val updated = withContext(Dispatchers.IO) { DebtDatabase(applicationContext).use { it.markCurrentPaymentPaid(loanId) } }
            if (updated != null) ReminderScheduler(applicationContext).schedule(updated)
           