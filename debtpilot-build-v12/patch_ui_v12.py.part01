# append helpers/theme before normalizeNumber
insert='''\n@Composable\nprivate fun SectionLabel(text: String) {\n    Text(text, style = MaterialTheme.typography.labelLarge, color = MaterialTheme.colorScheme.primary, fontWeight = FontWeight.Bold)\n}\n\n@Composable\nprivate fun DebtPilotTheme(content: @Composable () -> Unit) {\n    val colors = darkColorScheme(\n        primary = Color(0xFF65E6D1),\n        secondary = Color(0xFFA7B6FF),\n        tertiary = Color(0xFFFFC56E),\n        background = Color(0xFF080B10),\n        surface = Color(0xFF10151C),\n        surfaceVariant = Color(0xFF18212B),\n        error = Color(0xFFFF6B7A)\n    )\n    MaterialTheme(colorScheme = colors, content = content)\n}\n\nprivate fun twoDigits(v: Int): String = v.coerceIn(0, 99).toString().padStart(2, '0')\nprivate fun loanProgress(loan: Loan): Float = if (loan.originalAmount <= 0) 0f else ((loan.originalAmount - loan.remainingBalance) / loan.originalAmount).coerceIn(0.0, 1.0).toFloat()\nprivate fun alarmToneTitle(context: android.content.Context, value: String): String = runCatching {\n    val uri = if (value.isBlank()) ReminderScheduler.defaultAlarmUri() else Uri.parse(value)\n    RingtoneManager.getRingtone(context, uri)?.getTitle(context) ?: "Default alarm"\n}.getOrDefault("Default alarm")\n\n@Suppress("DEPRECATION")\nprivate fun pickedRingtoneUri(data: Intent?): Uri? = data?.getParcelableExtra(RingtoneManager.EXTRA_RINGTONE_PICKED_URI)\n\n'''
