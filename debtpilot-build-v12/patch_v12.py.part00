s=s.replace('''        put("status", loan.status.name)\n        put("notes", loan.notes)''','''        put("status", loan.status.name)\n        put("notes", loan.notes)\n        put("reminderHour", loan.reminderHour)\n        put("reminderMinute", loan.reminderMinute)\n        put("alarmSoundUri", loan.alarmSoundUri)\n        put("fullScreenAlarm", loan.fullScreenAlarm)\n        put("vibrateAlarm", loan.vibrateAlarm)''')
