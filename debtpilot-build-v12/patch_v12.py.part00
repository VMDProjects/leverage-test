s=s.replace('''    override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {\n        // v1 schema. Future versions should migrate, never silently destroy financial history.\n    }''','''    override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {\n        if (oldVersion < 2) {\n            db.execSQL("ALTER TABLE loans ADD COLUMN reminder_hour INTEGER NOT NULL DEFAULT 9")\n            db.execSQL("ALTER TABLE loans ADD COLUMN reminder_minute INTEGER NOT NULL DEFAULT 0")\n            db.execSQL("ALTER TABLE loans ADD COLUMN alarm_sound_uri TEXT NOT NULL DEFAULT ''")\n            db.execSQL("ALTER TABLE loans ADD COLUMN fullscreen_alarm INTEGER NOT NULL DEFAULT 1")\n            db.execSQL("ALTER TABLE loans ADD COLUMN vibrate_alarm INTEGER NOT NULL DEFAULT 1")\n        }\n    }''')
