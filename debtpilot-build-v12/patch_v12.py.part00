class ReminderScheduler(private val context: Context) {
    private val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as AlarmManager
    private val prefs = context.getSharedPreferences("settings", Context.MODE_PRIVATE)

    fun schedule(loan: Loan) {
        cancel(loan.id)
        if (loan.status != LoanStatus.ACTIVE) return
        scheduleOccurrence(loan, loan.nextDueDate)
    }

    fun scheduleOccurrence(loan: Loan, occurrenceDue: JalaliDate) {
        if (loan.status != LoanStatus.ACTIVE) return
        val hour = loan.reminderHour.coerceIn(0, 23)
        val minute = loan.reminderMinute.coerceIn(0, 59)
        val offsets = reminderOffsets()
        val now = System.currentTimeMillis()

        offsets.forEach { daysBefore ->
            val alertDate = ReminderPlanner.alertDate(occurrenceDue, loan.reminderDayOfMonth, loan.repeatMode, daysBefore)
            var trigger = alertDate.toGregorian().atTime(LocalTime.of(hour, minute))
                .atZone(ZoneId.systemDefault()).toInstant().toEpochMilli()
            if (trigger <= now && daysBefore != 0) return@forEach
            if (trigger <= now) trigger = now + 5_000
            setAlarm(trigger, pendingIntent(loan, occurrenceDue, daysBefore))
        }
        prefs.edit().putLong("lastAlarmScheduleEpoch", System.currentTimeMillis()).apply()
    }

    fun scheduleAll(loans: List<Loan>) = loans.forEach(::schedule)

    fun cancel(loanId: Long) {
        ALL_OFFSETS.forEach { offset -> alarmManager.cancel(pendingIntentForCancel(loanId, offset)) }
    }

    fun snooze(loanId: Long, code: String, name: String, balance: Double, due: String, soundUri: String, vibrate: Boolean, minutes: Int = 10) {
        val trigger = System.currentTimeMillis() + minutes.coerceAtLeast(1) * 60_000L
        val intent = Intent(context, AlarmReceiver::class.java).apply {
            putExtra("loanId", loanId); putExtra("code", code); putExtra("name", name)
            putExtra("balance", balance); putExtra("due", due); putExtra("offsetDays", 0)
            putExtra("soundUri", soundUri); putExtra("fullScreen", true); putExtra("vibrate", vibrate)
            putExtra("snoozed", true)
        }
        val pi = PendingIntent.getBroadcast(context, snoozeRequestCode(loanId), intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
        setAlarm(trigger, pi)
    }

    fun scheduleTestAlarm(seconds: Int = 10) {
        val trigger = System.currentTimeMillis() + seconds.co