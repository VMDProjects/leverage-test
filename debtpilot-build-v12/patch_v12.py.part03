 finishAlarm(loanId)
        }
    }

    private fun startSound() {
        val value=intent.getStringExtra("soundUri").orEmpty(); val uri=runCatching { if (value.isBlank()) ReminderScheduler.defaultAlarmUri() else Uri.parse(value) }.getOrElse { ReminderScheduler.defaultAlarmUri() }
        runCatching {
            player=MediaPlayer().apply {
                setAudioAttributes(AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_ALARM).setContentType(AudioAttributes.CONTENT_TYPE_MUSIC).build())
                setDataSource(this@AlarmActivity, uri); isLooping=true; prepare(); start()
            }
        }
    }
    private fun stopSound(){ runCatching { player?.stop() }; player?.release(); player=null }
    private fun finishAlarm(loanId: Long){ stopSound(); if (loanId!=0L) getSystemService(NotificationManager::class.java).cancel((((loanId % 200_000_000L)*10L)%Int.MAX_VALUE).toInt()); finishAndRemoveTask() }
}
''')

