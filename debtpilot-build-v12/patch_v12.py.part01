erceAtLeast(1) * 1_000L
        val intent = Intent(context, AlarmReceiver::class.java).apply {
            putExtra("isTest", true); putExtra("loanId", TEST_LOAN_ID); putExtra("name", "DebtPilot test alarm")
            putExtra("code", "TEST"); putExtra("due", JalaliDate.today().format()); putExtra("balance", 0.0)
            putExtra("offsetDays", 0); putExtra("soundUri", defaultAlarmUri().toString()); putExtra("fullScreen", true); putExtra("vibrate", true)
        }
        val pi = PendingIntent.getBroadcast(context, TEST_REQUEST_CODE, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
        setAlarm(trigger, pi)
    }

    fun sendTestNotificationNow() {
        context.sendBroadcast(Intent(context, AlarmReceiver::class.java).apply {
            putExtra("isTest", true); putExtra("loanId", TEST_LOAN_ID); putExtra("name", "DebtPilot test notification")
            putExtra("code", "TEST"); putExtra("due", JalaliDate.today().format()); putExtra("balance", 0.0)
            putExtra("offsetDays", 0); putExtra("soundUri", defaultAlarmUri().toString()); putExtra("fullScreen", false); putExtra("vibrate", true)
        })
    }

    fun canScheduleExact(): Boolean = Build.VERSION.SDK_INT < Build.VERSION_CODES.S || alarmManager.canScheduleExactAlarms()
    fun notificationsAllowed(): Boolean = NotificationManagerCompat.from(context).areNotificationsEnabled()
    fun canUseFullScreenIntents(): Boolean = Build.VERSION.SDK_INT < 34 || context.getSystemService(NotificationManager::class.java).canUseFullScreenIntent()
    fun lastScheduleEpoch(): Long = prefs.getLong("lastAlarmScheduleEpoch", 0L)

    fun exactAlarmSettingsIntent(): Intent = Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM).apply { data = Uri.parse("package:${context.packageName}") }
    fun fullScreenSettingsIntent(): Intent = if (Build.VERSION.SDK_INT >= 34) Intent(Settings.ACTION_MANAGE_APP_USE_FULL_SCREEN_INTENT).apply { data = Uri.parse("package:${context.packageName}") } else Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply { data = Uri.parse("package:${context.packageName}") }

    private fun reminderOffsets(): Set<Int> = buildSet {
        add(0)
        if (prefs.getBoolean("remind1DayBefore", true)) add(1)
        if (prefs.getBoolean("remind3DaysBefore", false)) add(3)
    }

    private fun setAlarm(trigger: Long, pi: PendingIntent) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && !alarmManager.canScheduleExactAlarms()) alarmManager.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, trigger, pi)
        else alarmManager.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, trigger, pi)
    }

    private fun requestCode(loanId: Long, offsetDays: Int): Int = ((loanId % 200_000_000L) * 10L + when (offsetDays) { 0 -> 0; 1 -> 1; 3 -> 3; else -> 9 }).toInt()
    private fun snoozeRequestCode(loanId: Long): Int = (((loanId % 200_000_000L) * 10L + 8L) % Int.MAX_VALUE).toInt()

    private fun pendingIntent(loan: Loan, occurrenceDue: JalaliDate, offsetDays: Int): PendingIntent {
        val sound = loan.alarmSoundUri.ifBlank { defaultAlarmUri().toString() }
        val intent = Intent(context, AlarmReceiver::class.java).apply {
            putExtra("loanId", loan.id); putExtra("code", loan.code); putExtra("name", loan.name); putExtra("balance", loan.remainingBalance)
            putExtra("due", occurrenceDue.format()); putExtra("offsetDays", offsetDays); putExtra("soundUri", sound)
            putExtra("fullScreen", loan.fullScreenAlarm && offsetDays == 0); putExtra("vibrate", loan.vibrateAlarm)
            putExtra("scheduledAmount", when { loan.installmentAmount > 0 -> loan.installmentAmount; loan.minimumPayment > 0 -> loan.minimumPayment; else -> 0.0 })
        }
        return PendingIntent.getBroadcast(context, requestCode(loan.id, offsetDays), intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
    }

    private fun pendingIntentForCancel(loanId: Long, offsetDays: Int): PendingIntent {
        val intent = Intent(context, AlarmReceiver::class.java)
        return PendingIntent.getBroadcast(context, requestCode(loanId, offsetDays), intent, PendingIntent.FLAG_NO_CREATE or PendingIntent.FLAG_IMMUTABLE)
            ?: PendingIntent.getBroadcast(context, requestCode(loanId, offsetDays), intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
    }

    companion object {
        private val ALL_OFFSETS = listOf(0, 1, 3)
        private const val TEST_LOAN_ID = -9999L
        private const val TEST_REQUEST_CODE = 2_147_000_001
        fun defaultAlarmUri(): Uri = RingtoneManager.getDefaultUri(RingtoneManager.TYPE_ALARM)
            ?: RingtoneManager.getDefaultUri(RingtoneManager.TYPE_NOTIFICATION)
    }
}
''')

