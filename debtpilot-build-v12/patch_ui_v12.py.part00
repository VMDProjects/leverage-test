t = Arrangement.spacedBy(8.dp)) {\n                                Text("Alarm tone", fontWeight = FontWeight.SemiBold)\n                                Text(alarmToneTitle(context, soundUri), color = MaterialTheme.colorScheme.onSurfaceVariant)\n                                OutlinedButton(onClick = {\n                                    val existing = runCatching { Uri.parse(soundUri.ifBlank { ReminderScheduler.defaultAlarmUri().toString() }) }.getOrNull()\n                                    soundPicker.launch(Intent(RingtoneManager.ACTION_RINGTONE_PICKER).apply {\n                                        putExtra(RingtoneManager.EXTRA_RINGTONE_TYPE, RingtoneManager.TYPE_ALARM)\n                                        putExtra(RingtoneManager.EXTRA_RINGTONE_SHOW_DEFAULT, true)\n                                        putExtra(RingtoneManager.EXTRA_RINGTONE_SHOW_SILENT, false)\n                                        putExtra(RingtoneManager.EXTRA_RINGTONE_EXISTING_URI, existing)\n                                        putExtra(RingtoneManager.EXTRA_RINGTONE_TITLE, "Choose payment alarm sound")\n                                    })\n                                }, modifier = Modifier.fillMaxWidth()) { Text("Choose alarm sound") }\n                                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.SpaceBetween) { Text("Full-screen alarm") ; Switch(checked = fullScreenAlarm, onCheckedChange = { fullScreenAlarm = it }) }\n                                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.SpaceBetween) { Text("Vibrate") ; Switch(checked = vibrateAlarm, onCheckedChange = { vibrateAlarm = it }) }\n                            }\n                        }\n                    }''')
